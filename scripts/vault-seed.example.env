JWT_SECRET=change-me

# Access key of the IAM user homelab-cert-manager (Route53 DNS-01 for cert-manager)
CERT_MANAGER_ACCESS_KEY_ID=
CERT_MANAGER_SECRET_ACCESS_KEY=
