# Copy to scripts/vault-seed.env (gitignored) and fill in the values.
# Used by scripts/seed-vault.sh.

DB_HOST=192.168.0.30
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_DATABASE=ecommerce

JWT_SECRET=change-me

# Access key of the IAM user homelab-cert-manager (Route53 DNS-01 for cert-manager)
CERT_MANAGER_ACCESS_KEY_ID=
CERT_MANAGER_SECRET_ACCESS_KEY=

# Keycloak: password of the "keycloak" Postgres user, and the console admin password
KEYCLOAK_DB_PASS=
KEYCLOAK_ADMIN_PASSWORD=
# Secret of the client "keycloak-config-cli" in the Keycloak master realm (Clients, keycloak-config-cli, Credentials)
KEYCLOAK_CONFIG_CLI_CLIENT_SECRET=

# Secret of the "grafana" client in the Keycloak "platform" realm (Clients, grafana, Credentials)
GRAFANA_KEYCLOAK_CLIENT_SECRET=

# Password of the built-in Grafana admin user. The Grafana sidecars log in with it.
GRAFANA_ADMIN_PASSWORD=
