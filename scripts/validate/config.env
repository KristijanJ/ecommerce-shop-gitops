# Settings for the validation scripts. Local runs and CI both read this file.

# Kubernetes version to validate against.
# The homelab runs k3s v1.36.4 and aws-prod runs EKS 1.36.
KUBERNETES_VERSION=1.36.0

# Environments to validate. The "local" overlays are left out on purpose,
# because no ApplicationSet selects them.
ENVIRONMENTS="homelab aws-prod"

# Where kubeconform looks for the schemas of custom resources
# (ExternalSecret, Certificate, ServiceMonitor, ApplicationSet, ...).
CRD_SCHEMA_URL='https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'

# Kinds that kubeconform does not check. Every other kind without a schema is
# still an error.
#   ClusterSecretStore, SecretStore: kubeconform fails to load the catalog
#     schema for these ("could not find schema"), even when the schema file is
#     local and valid JSON. Only apps/infrastructure/envs/* is affected.
#   CustomResourceDefinition: no schema exists for it, and the charts ship
#     these CRDs as written by their vendors.
KUBECONFORM_SKIP_KINDS=ClusterSecretStore,SecretStore,CustomResourceDefinition

# Settings for diff-rendered.sh, the report of what a pull request changes.
# Kinds that are left out of the report. CRDs from charts are huge and change
# only when a chart version changes.
DIFF_SKIP_KINDS="CustomResourceDefinition"
# Limits that keep the report short. Everything over a limit is counted but
# not printed.
# Resource names to list per app and per kind of change (added, changed, removed).
DIFF_MAX_LISTED=30
# Changed resources per app that get an expandable diff.
DIFF_MAX_DIFFS=10
# Longest diff, in lines, for one changed resource.
DIFF_MAX_LINES=40

# Tool versions. install-tools.sh downloads exactly these and checks the
# SHA-256 of every download. When you bump a version, copy the new
# checksum from the tool's GitHub release page.
KUBECONFORM_VERSION=0.8.0
KUBECONFORM_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883

YQ_VERSION=4.54.1
YQ_SHA256=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f

GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
